# ---------------------------------------------------------------------------
# 本地运行产物 —— 一律不入库
# ---------------------------------------------------------------------------

# data/ 里存着你的推送密钥（Server酱 SendKey、企业微信 webhook、PushPlus token）。
# 这个目录一旦推上公开仓库，等于把微信推送入口送给别人，务必保持忽略。
data/

# 日志、守护进程运行时文件
logs/
*.log
*.pid
watchdog.off

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境（本项目零依赖，一般用不到）
.venv/
venv/
env/

# Vercel CLI 的本地状态（用网页导入部署不会产生，用 CLI 会）
.vercel/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 方案原文（含策略细节，不随仓库公开）
*.docx
